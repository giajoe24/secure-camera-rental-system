digraph G {
  rankdir=LR;
  graph [fontname="Noto Sans CJK JP", fontsize=14, bgcolor="white", pad=0.3, dpi=150, nodesep=0.35, ranksep=0.45];
  node  [fontname="Noto Sans CJK JP", fontsize=13, shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#98A2B3", margin="0.18,0.08"];
  edge  [fontname="Noto Sans CJK JP", fontsize=11, color="#475467", fontcolor="#344054"];
  label="UnlockScreen.watch_lock(0.2 秒ごとにスイッチを見る)"; labelloc=t; fontsize=16;
  start [label="ロックを外した", shape=oval, fillcolor="#D1E9FF", color="#2E90FA"];
  wait [label="待ち\n(まだ施錠のまま)"];
  open [label="開いた\n「閉めてください」"];
  warn [label="黄色の警告\n(1 回だけ)", fillcolor="#FEF0C7", color="#F79009"];
  fin [label="finish()\n「完了」を書く\nExcel → 完了画面", fillcolor="#D1FADF", color="#12B76A"];
  gu [label="give_up()\n「取り消し」を書く\nExcel → 取り消し画面", fillcolor="#FEE4E2", color="#F04438"];
  start -> wait; wait -> open [label="スイッチが\n「解錠」になった"]; open -> fin [label="スイッチが\n「施錠」に戻った"];
  wait -> gu [label="30 秒たった"]; open -> warn [label="60 秒たった"]; warn -> fin [label="閉めた"];
}
